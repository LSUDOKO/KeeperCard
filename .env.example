# KeeperCard server (packages/server)
ATTESTPAY_MASTER_KEY=          # required: 64 hex chars (32 bytes); encrypts agent keys + card secrets at rest
ATTESTPAY_ADMIN_TOKEN=         # ops lane: bearer token with FULL access to the management API (/api/*) — server-side curl/scripts only
ATTESTPAY_PRIVY_APP_ID=        # dashboard lane: enables per-user auth (Privy access tokens verified against this app's JWKS)
PORT=4070
ATTESTPAY_DB_PATH=.dev/attestpay.sqlite
ATTESTPAY_RPC_URL=https://mainnet.base.org
#ATTESTPAY_CHAIN_ID=8453       # settlement chain: 8453 Base mainnet (default), 84532 Base Sepolia (the demo)
ATTESTPAY_PUBLIC_MCP_BASE=     # public origin used when rendering card URLs, e.g. https://api.example.com (also arms the MCP Host allowlist; unset = localhost)
ATTESTPAY_ALLOWED_HOSTS=       # extra Host headers accepted on /mcp + /c/<secret>/mcp (comma-separated)
ATTESTPAY_CORS_ORIGINS=        # comma-separated allowed origins for the API, e.g. https://app.example.com
ATTESTPAY_DEV_USER_PK=         # dev only: server-custodied user key for the server-signed issuance lane
ATTESTPAY_FACILITATOR_BASE=    # x402 facilitator base URL (defaults to this server)
ATTESTPAY_SELLER_PAYTO=        # payout address for the built-in demo seller
ATTESTPAY_PAID_FETCH_ALLOW_LOCAL=  # set to 1 to let paid_fetch hit local/private hosts (dev only)
ATTESTPAY_STRIPE_WEBHOOK_SECRET=   # Stripe real-time auth webhook signing secret (test mode); unset = fiat leg disabled (503)
STRIPE_SECRET_KEY=             # Stripe TEST-mode secret key (sk_test_/rk_test_ ONLY; anything else is refused); enables the fiat trigger + card credential tools
ATTESTPAY_FIAT_SETTLEMENT=         # set to 1: approved Visa charges settle on-chain as real delegated USDC transfers to the settlement address
ATTESTPAY_SETTLEMENT_ADDRESS=      # settlement recipient for the fiat leg; defaults to the fee collector
ATTESTPAY_DASHBOARD_BASE=          # dashboard origin hosting the OAuth consent page, e.g. https://app.example.com (default http://localhost:4071)
# Optional tuning (defaults apply when unset; uncomment to override):
#ATTESTPAY_RECONCILE_INTERVAL_MS=300000   # stuck-pending-charge reconcile sweep interval, ms (0 disables)
#ATTESTPAY_FIAT_FEE_HEADROOM=0.02         # USDC reserved for the settlement fee in the authorization decision (settlement mode only; live relayer minFee ~0.011)
#ATTESTPAY_FIAT_SETTLE_INTERVAL_MS=60000  # unsettled fiat charge sweep interval, ms
#ATTESTPAY_MCP_RATE_LIMIT=240             # per-card MCP request ceiling per minute
#ATTESTPAY_MCP_BAD_SECRET_LIMIT=30        # per-IP bad-credential attempt ceiling per minute
#ATTESTPAY_OAUTH_ACCESS_TTL=3600          # OAuth access-token lifetime, seconds
#ATTESTPAY_OAUTH_REFRESH_TTL=2592000      # OAuth refresh-token lifetime, seconds (30 days)
#ATTESTPAY_OAUTH_REDIRECT_HOSTS=          # if set, restrict https redirect-uri hosts to this comma-separated allowlist (recommended in prod; loopback + custom schemes always allowed)
#ATTESTPAY_OAUTH_ACCEPTED_RESOURCES=      # extra RFC 8707 resource URIs still honored (legacy values during a base-URL migration; comma-separated)
#ATTESTPAY_OAUTH_REGISTER_LIMIT=10        # per-IP client-registration ceiling per minute
#ATTESTPAY_OAUTH_AUTHORIZE_LIMIT=30       # per-IP authorize-request ceiling per minute
#ATTESTPAY_OAUTH_TOKEN_LIMIT=60           # per-IP token/revoke-request ceiling per minute
#ATTESTPAY_TRUST_PROXY_HOPS=1             # trusted proxy hops for client-IP rate-limiting (Railway=1; CDN+Railway=2; 0 disables XFF trust)

# KeeperCard dashboard (packages/dashboard)
# The dashboard authenticates as the USER: every API call carries the Privy session
# token, verified server-side. No admin token ever reaches the browser.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_ATTESTPAY_API=http://localhost:4070/api
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
#NEXT_PUBLIC_ATTESTPAY_CHAIN_ID=8453   # must match the server's ATTESTPAY_CHAIN_ID (84532 for the Base Sepolia demo)

# OpenTelemetry (SigNoz)
#
# For local SigNoz (from casting.yaml):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# For SigNoz Cloud (https://signoz.io):
#   1. Get your ingestion key from SigNoz Cloud dashboard -> Settings -> Ingestion Settings
#   2. Set the endpoint to your region (us, us2, eu, etc.) and the ingestion key header:
#
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us2.signoz.cloud
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=YOUR_KEY_HERE
#
# All three exporters default to otlp when the endpoint is set.
# Uncomment to force them:
#OTEL_TRACES_EXPORTER=otlp
#OTEL_METRICS_EXPORTER=otlp
#OTEL_LOGS_EXPORTER=otlp
#ATTESTPAY_OTEL_DEBUG=0                              # set to 1 for verbose OTel SDK logs

# ---------------------------------------------------------------------------
# Webhooks, events, audit log
# ---------------------------------------------------------------------------
# Always on (rides the same sqlite database). Webhooks are created per user from the
# dashboard (Settings) or POST /api/webhooks; every delivery is signed with the
# webhook's secret (X-KeeperCard-Signature: t=<unix>,v1=<hmac-sha256>) and retried
# with backoff (30s, 2m, 10m, 1h, 6h) before being marked dead.
#ATTESTPAY_WEBHOOK_INTERVAL_MS=15000   # delivery sweep interval, ms (0 disables delivery)
#ATTESTPAY_WEBHOOK_ALLOW_LOCAL=0       # set to 1 to allow http:// and private-network webhook URLs (dev only)

# ---------------------------------------------------------------------------
# KeeperHub — the execution layer
# ---------------------------------------------------------------------------
# KeeperCard decides what may be spent; KeeperHub moves it. Nonce management, gas
# estimation, retries with backoff, private routing and the execution audit trail are
# KeeperHub's. Without KEEPERHUB_API_KEY the server FAILS LOUDLY on every payment
# (keeperhub_not_configured) rather than silently no-op'ing — set ATTESTPAY_EXECUTOR=1shot
# to fall back to the legacy relayer instead.
#
# Setup:  https://app.keeperhub.com → Settings → Developer → API keys → Organisation keys
#   1. create a kh_ key and set it below
#   2. add a web3 wallet integration (Settings → Integrations) — it signs every write
#   3. bun run --cwd packages/server keeperhub:provision   # creates the workflows
#   4. bun run --cwd packages/server keeperhub:doctor      # verifies the whole lane
#
# See docs/keeperhub/api-notes.md for how the API actually behaves.
#KEEPERHUB_API_KEY=kh_...
#KEEPERHUB_API_BASE=https://app.keeperhub.com/api
#KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# Refuse to execute a payment that has not been dry-run in the same call chain. This is
# the hackathon's core theme and the reason an agent cannot improvise a transfer; leave
# it on unless you are debugging. Only "0" disables it.
#KEEPERHUB_DRY_RUN_REQUIRED=1

# Workflow ids are NOT configured here. The server resolves every workflow BY NAME at
# boot (card-payment-redemption, x402-settlement, fiat-settlement, guarded-card-payment,
# payment-receipt-anchor, receipt-event-watcher, fee-income-watcher, treasury-monitor,
# market-guard, ...), and provisioning is idempotent, so nothing needs copying around.
# Optional pin: KEEPERHUB_WORKFLOW_<KEY>=<workflow id> overrides the lookup for one
# workflow. Keys: PAY X402 SETTLE GUARDED ANCHOR RECEIPTS FEES TREASURY MARKET RECOVERY
# SWEEP NOTIFY.
#KEEPERHUB_WORKFLOW_PAY=

# The org's signing wallet. Optional: it is resolved from the wallet integration when
# unset. Set it to make a mismatch a loud failure rather than a silent surprise.
#KEEPERHUB_WALLET_ADDRESS=0x...

# Shared secret for the workflow callbacks into /api/keeperhub/hooks/*. Only meaningful
# on a plan where the HTTP Request action is available (Pro): on the free plan nothing
# calls back and KeeperCard polls KeeperHub instead. Generated by provision if unset.
#KEEPERHUB_HOOK_SECRET=

# How long a reviewed plan stays executable, and the fee quoted for gas on a card
# payment. A short TTL is a safety property: a plan cannot be executed long after the
# terms it was reviewed under.
#KEEPERHUB_PLAN_TTL_SECONDS=600
#KEEPERHUB_GAS_FEE_USDC=0.01
#KEEPERHUB_GAS_LIMIT_MULTIPLIER=1.5

# On-chain receipts. Every confirmed payment gets a PaymentAnchor.anchorPayment record,
# written by KeeperHub on the SAME chain the payment settled on. Base Sepolia deployment:
# 0x56733223c688cce7fc65826b692b3f8521e4ab3e. Unset = the receipt workflows are skipped.
#KEEPERHUB_RECEIPT_ANCHOR_ADDRESS=0x56733223c688cce7fc65826b692b3f8521e4ab3e
#KEEPERHUB_RECEIPT_SWEEP_INTERVAL_MS=120000   # how often unanchored payments are retried, ms

# Payments at or above this many USDC run through guarded-card-payment (risk-scored
# before redemption) instead of card-payment-redemption. Unset = never.
#KEEPERHUB_GUARDED_MIN_USDC=

# Depeg guard. The dry run refuses a payment when Chainlink USDC/USD reads below this
# floor. Default 0.98; "0" or "off" disables the check.
#KEEPERHUB_DEPEG_FLOOR=0.98

# Cron for the scheduled workflows. treasury-monitor and market-guard run on every plan;
# stuck-charge-recovery and fiat-settlement-sweep use the HTTP Request action (Pro only).
#KEEPERHUB_TREASURY_CRON=*/10 * * * *
#KEEPERHUB_MARKET_CRON=0 * * * *
#KEEPERHUB_RECOVERY_CRON=*/5 * * * *
#KEEPERHUB_SETTLE_CRON=*/2 * * * *

# Notification relay targets (non-payment-critical events only — payment-critical
# webhooks stay on KeeperCard's own HMAC-signed queue). The notification-relay workflow
# is only provisioned when at least one of these is set.
#KEEPERHUB_DISCORD_INTEGRATION_ID=
#KEEPERHUB_TELEGRAM_INTEGRATION_ID=
#KEEPERHUB_TELEGRAM_CHAT_ID=
#KEEPERHUB_SENDGRID_INTEGRATION_ID=
#KEEPERHUB_NOTIFY_EMAIL=
#KEEPERHUB_NOTIFY_WEBHOOK_URL=

# KeeperHub submits ordinary type-2 transactions, so an account that has never spent
# needs its one-time EIP-7702 upgrade submitted separately. This sponsor key pays for
# that single zero-value transaction; no value moves in it. Without it, a first spend
# from a fresh account returns a typed smart_account_not_upgraded error.
#
# KeeperHub's gas sponsorship does NOT cover this: sponsorship applies to direct wallet
# sends, and the upgrade is a type-4 (authorization) transaction. So this wallet needs a
# little native gas on the settlement chain — and very little: the upgrade costs about
# 46k gas, which on Base Sepolia is ~0.0000003 ETH, so 0.001 ETH covers thousands of
# accounts. Accepts the key with or without the 0x prefix.
#ATTESTPAY_7702_SPONSOR_PK=0x...

# Rollback lane: "1shot" (or "legacy") restores the old relayer and disables KeeperHub
# entirely, with a loud warning at boot. Default is keeperhub.
#ATTESTPAY_EXECUTOR=keeperhub

# Skip a fiat settlement sweep when the settlement account holds less than this many USDC
# atoms (6dp, so 1000000 = 1.00 USDC). The floor is read through KeeperHub's
# check-and-execute, which performs the read and the guarded write in one request, so the
# balance cannot move between deciding and acting. 0 (default) disables the guard; when
# the check cannot be evaluated the sweep proceeds, because a balance oracle being down
# must not stop settlement.
#ATTESTPAY_SETTLE_MIN_USDC_ATOMS=0
